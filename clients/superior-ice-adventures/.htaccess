# Superior Ice Adventures - URL rewrites + live domain
RewriteEngine On

# cPanel CGI/FastCGI does not fill PHP_AUTH_USER unless Authorization is passed through.
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Production only: HTTPS + apex (superioriceadventures.com)
RewriteCond %{HTTP_HOST} ^(www\.)?superioriceadventures\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://superioriceadventures.com%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^www\.superioriceadventures\.com$ [NC]
RewriteRule ^ https://superioriceadventures.com%{REQUEST_URI} [L,R=301]

# Staging hosts: prefer HTTPS when available (hyphenated preferred; legacy host kept)
RewriteCond %{HTTP_HOST} ^(superior-ice-adventures|superioriceadventures)\.webstarbusinessservices\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Clean article URLs: /articles/slug/ -> article.php?slug=slug
RewriteRule ^articles/([a-z0-9-]+)/?$ articles/article.php?slug=$1 [L,QSA]
