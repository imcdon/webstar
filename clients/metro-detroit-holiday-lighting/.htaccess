# Metro Detroit Holiday Lighting - URL rewrites + live domain
RewriteEngine On

# cPanel CGI/FastCGI does not fill PHP_AUTH_USER unless Authorization is passed through.
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Production only: HTTPS + apex
RewriteCond %{HTTP_HOST} ^(www\.)?metrodetroitholidaylighting\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://metrodetroitholidaylighting.com%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^www\.metrodetroitholidaylighting\.com$ [NC]
RewriteRule ^ https://metrodetroitholidaylighting.com%{REQUEST_URI} [L,R=301]

# Sitemap XML alias
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# City landing pages: /service-areas/troy/ -> city.php?city=troy
RewriteRule ^service-areas/([a-z0-9-]+)/?$ service-areas/city.php?city=$1 [L,QSA]

# Branded 404
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !404\.php$
RewriteRule . 404.php [L]

ErrorDocument 404 /404.php

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|webp|png|jpg|jpeg|svg)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>
</IfModule>
