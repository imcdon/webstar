# Webstar Business Services — clean URLs
# Works at domain root (production) and in a subdirectory (local XAMPP).

DirectoryIndex index.php

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Production: apex → www, HTTP → HTTPS (skip localhost / XAMPP)
    RewriteCond %{HTTP_HOST} ^webstarbusinessservices\.com$ [NC]
    RewriteRule ^ https://www.webstarbusinessservices.com%{REQUEST_URI} [R=301,L]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} ^www\.webstarbusinessservices\.com$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    RewriteRule ^debug-.*\.log$ - [F,L]

    # --- 301: legacy .php / query URLs → clean paths (use THE_REQUEST for correct base) ---

    # /…/index.php → /…/
    RewriteCond %{THE_REQUEST} \s/+((?:[^?\s]*?/)?)index\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # /…/packages.php → /…/packages/  (and examples, about, contact, privacy, terms, plans, process, accessibility)
    RewriteCond %{THE_REQUEST} \s/+((?:[^?\s]*?/)?)(packages|examples|about|contact|privacy|terms|plans|process|accessibility|service-areas|industries|resources|reviews)\.php[\s?] [NC]
    RewriteRule ^ /%1%2/? [R=301,L]

    # /…/package.php?slug=x → /…/packages/x/
    RewriteCond %{THE_REQUEST} \s/+((?:[^?\s]*?/)?)package\.php\?[^\s]*slug=([^\s&]+) [NC]
    RewriteRule ^ /%1packages/%2/? [R=301,L]

    # Retired / renamed package slugs (service restructure) — keep %1 prefix so this works in a subdirectory too
    RewriteCond %{THE_REQUEST} \s/+((?:[^?\s]*?/)?)packages/marketing/?[\s?] [NC]
    RewriteRule ^ /%1packages/ [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+((?:[^?\s]*?/)?)packages/get-me-on-google/?[\s?] [NC]
    RewriteRule ^ /%1packages/simple-website/ [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+((?:[^?\s]*?/)?)packages/business-website-marketing/?[\s?] [NC]
    RewriteRule ^ /%1packages/business-website/ [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+((?:[^?\s]*?/)?)packages/custom-growth/?[\s?] [NC]
    RewriteRule ^ /%1packages/business-growth-website/ [R=301,L]
    RewriteCond %{THE_REQUEST} \s/+((?:[^?\s]*?/)?)small-business-marketing-package-michigan/?[\s?] [NC]
    RewriteRule ^ /%1packages/business-website/ [R=301,L]

    # /…/landing.php?slug=x → /…/x/
    RewriteCond %{THE_REQUEST} \s/+((?:[^?\s]*?/)?)landing\.php\?[^\s]*slug=([^\s&]+) [NC]
    RewriteRule ^ /%1%2/? [R=301,L]

    # Weddings clean paths (before directory pass-through)
    RewriteRule ^weddings/services/?$ weddings/services.php [L,QSA]
    RewriteRule ^weddings/examples/?$ weddings/examples.php [L,QSA]

    # Serve remaining real files and directories as-is
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # --- Internal rewrites (clean → PHP) ---

    RewriteRule ^packages/([a-z0-9-]+)/?$ package.php?slug=$1 [L,QSA]
    RewriteRule ^packages/?$ packages.php [L,QSA]

    RewriteRule ^(examples|about|contact|privacy|terms|plans|process|accessibility|service-areas|industries|resources|reviews)/?$ $1.php [L,QSA]

    RewriteRule ^resources/feed/?$ resources-feed.php [L,QSA]
    RewriteRule ^resources/([a-z0-9-]+)/?$ article.php?slug=$1 [L,QSA]

    # SEO landings: /{slug}/ → landing.php (skip reserved first segments)
    RewriteCond %{REQUEST_URI} !/(packages|examples|about|contact|privacy|terms|plans|process|accessibility|service-areas|industries|resources|reviews|portal|clients|library|assets|scripts|vendor|weddings)(/|$) [NC]
    RewriteRule ^([a-z0-9-]+)/?$ landing.php?slug=$1 [L,QSA]
</IfModule>
